---
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import InstallBlock from "../../components/InstallBlock.astro";
import Footer from "../../components/Footer.astro";

const base = import.meta.env.BASE_URL;

const rows = [
  ["Price", "Free, open source (MIT)", "Paid, commercial license"],
  ["Platforms", "macOS, Linux (no Windows)", "macOS, Windows, Linux"],
  ["Interface", "CLI, interactive TUI, Web UI, REST API", "Desktop GUI"],
  ["HTTPS interception", "Yes — local root CA", "Yes — SSL Proxying with root CA"],
  ["WebSocket capture", "Yes — capture, replay, and follow", "Yes"],
  ["HTTP/2 support", "No — MITM'd connections pinned to HTTP/1.1", "Yes"],
  ["Request breakpoints / live rewriting", "No", "Yes"],
  ["Bandwidth throttling", "Yes — presets or custom rates", "Yes"],
  ["Scripting / extensibility", "CLI filters and flags only", "Rewrite rules, Map Local/Remote (no scripting API)"],
  ["AI agent integration", "Claude Code plugin + skill, --format agent output", "None built-in"],
];

const faqs = [
  {
    q: "Is Laurel Proxy really free?",
    a: "Yes. Laurel Proxy is free and open source under the MIT license, with no paid tier. Charles Proxy is commercial software.",
  },
  {
    q: "Does Laurel Proxy run on Windows?",
    a: "No. Laurel Proxy supports macOS and Linux only. Charles Proxy also runs on Windows.",
  },
  {
    q: "Can Laurel Proxy fully replace Charles Proxy?",
    a: "Not for every workflow. Laurel Proxy is a strong fit for terminal-first and AI-agent-assisted debugging, and it now captures WebSocket traffic and throttles bandwidth to simulate real-world network conditions. It still has no request breakpoints and pins intercepted HTTPS connections to HTTP/1.1 — Charles wins on both.",
  },
];
---

<Base
  title="Laurel Proxy vs Charles Proxy: A Free, Open Alternative"
  description="Compare Laurel Proxy and Charles Proxy: free vs. paid, terminal-first vs. GUI, AI-agent support, and where Charles still wins on breakpoints and HTTP/2."
  structuredData={{
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  }}
>
  <Nav />

  <main id="main" role="main">
    <!-- Hero -->
    <section class="px-6 md:px-12 pt-16 md:pt-24 pb-12 md:pb-16">
      <div class="max-w-3xl mx-auto text-center">
        <span class="inline-block text-xs text-accent border border-accent/30 rounded-full px-3 py-1 mb-6 font-medium">
          Charles Proxy Alternative
        </span>

        <h1 class="text-text-primary text-3xl md:text-5xl font-extrabold tracking-tight leading-[1.1] mb-5">
          Laurel Proxy vs <span class="text-accent">Charles Proxy</span>
        </h1>

        <p class="text-text-secondary text-base md:text-xl leading-relaxed mb-8 max-w-2xl mx-auto">
          Charles Proxy is a mature, paid GUI tool with request breakpoints and full HTTP/2 support. Laurel Proxy is a free,
          open-source, terminal-first proxy built for developers and AI agents. Here's an honest comparison.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <InstallBlock />
        </div>
      </div>
    </section>

    <!-- Comparison table -->
    <section class="px-6 md:px-12 py-12 md:py-16 border-t border-border">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-text-primary text-2xl md:text-3xl font-bold tracking-tight mb-6 text-center">
          Feature comparison
        </h2>
        <div class="overflow-x-auto rounded-lg border border-border">
          <table class="w-full text-sm border-collapse">
            <thead>
              <tr class="bg-bg-secondary">
                <th class="text-left text-text-primary font-semibold uppercase tracking-wide text-xs px-4 py-3 border-b border-border">Feature</th>
                <th class="text-left text-accent font-semibold uppercase tracking-wide text-xs px-4 py-3 border-b border-border">Laurel Proxy</th>
                <th class="text-left text-text-primary font-semibold uppercase tracking-wide text-xs px-4 py-3 border-b border-border">Charles Proxy</th>
              </tr>
            </thead>
            <tbody>
              {rows.map(([feature, laurel, charles], i) => (
                <tr class={i % 2 === 0 ? "" : "bg-bg-secondary/40"}>
                  <td class="px-4 py-3 border-b border-border text-text-primary font-medium align-top">{feature}</td>
                  <td class="px-4 py-3 border-b border-border text-text-secondary align-top">{laurel}</td>
                  <td class="px-4 py-3 border-b border-border text-text-secondary align-top">{charles}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Where Charles is better -->
    <section class="px-6 md:px-12 py-12 md:py-16 border-t border-border">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-text-primary text-2xl md:text-3xl font-bold tracking-tight mb-6">
          Where Charles Proxy is still better
        </h2>
        <p class="text-text-secondary mb-6 leading-relaxed">
          Laurel Proxy is not trying to out-feature a 20-year-old commercial tool. Be honest with yourself about
          these gaps before you switch:
        </p>
        <ul class="space-y-3">
          <li class="flex items-start gap-3">
            <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-text-muted shrink-0"></span>
            <span class="text-text-secondary"><strong class="text-text-primary">Request breakpoints.</strong> Charles can pause a live request or response mid-flight and let you edit it before it continues. Laurel Proxy only replays already-captured requests after the fact.</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-text-muted shrink-0"></span>
            <span class="text-text-secondary"><strong class="text-text-primary">Full HTTP/2 support.</strong> Laurel Proxy pins intercepted HTTPS connections to HTTP/1.1 via ALPN. If you need to debug HTTP/2-specific behavior, Charles handles it natively.</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-text-muted shrink-0"></span>
            <span class="text-text-secondary"><strong class="text-text-primary">Windows support.</strong> Charles runs on Windows, macOS, and Linux. Laurel Proxy does not support Windows.</span>
          </li>
        </ul>
      </div>
    </section>

    <!-- Choose / Stick with -->
    <section class="px-6 md:px-12 py-12 md:py-16 border-t border-border">
      <div class="max-w-4xl mx-auto grid md:grid-cols-2 gap-6">
        <div class="rounded-lg border border-accent/30 bg-bg-secondary/50 p-6">
          <h3 class="text-accent font-bold text-lg mb-4">Choose Laurel Proxy if...</h3>
          <ul class="space-y-2 text-text-secondary text-sm leading-relaxed">
            <li>You're on macOS or Linux and want a free, open-source tool</li>
            <li>You or your AI agent want to query traffic from a terminal or REST API</li>
            <li>You debug with Claude Code and want <code class="text-accent">--format agent</code> output</li>
            <li>You want a queryable local history without manual session files</li>
            <li>You want WebSocket capture and bandwidth throttling without a paid license</li>
          </ul>
        </div>
        <div class="rounded-lg border border-border bg-bg-secondary/50 p-6">
          <h3 class="text-text-primary font-bold text-lg mb-4">Stick with Charles Proxy if...</h3>
          <ul class="space-y-2 text-text-secondary text-sm leading-relaxed">
            <li>You need Windows support</li>
            <li>You need breakpoints to pause and edit live requests</li>
            <li>You need full HTTP/2 fidelity</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="px-6 md:px-12 py-12 md:py-16 border-t border-border">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-text-primary text-2xl md:text-3xl font-bold tracking-tight mb-6">
          Frequently asked questions
        </h2>
        <div class="space-y-6">
          {faqs.map((faq) => (
            <div>
              <h3 class="text-text-primary font-semibold mb-1">{faq.q}</h3>
              <p class="text-text-secondary text-sm leading-relaxed">{faq.a}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Docs links -->
    <section class="px-6 md:px-12 py-12 md:py-16 border-t border-border">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-text-primary text-xl md:text-2xl font-bold tracking-tight mb-4">
          Learn more
        </h2>
        <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm">
          <a href={`${base}docs/getting-started/`} class="text-accent hover:text-accent-dim transition-colors">Getting Started &rarr;</a>
          <a href={`${base}docs/https/`} class="text-accent hover:text-accent-dim transition-colors">HTTPS Interception &rarr;</a>
          <a href={`${base}docs/cli/`} class="text-accent hover:text-accent-dim transition-colors">CLI Reference &rarr;</a>
          <a href={`${base}docs/agent-plugin/`} class="text-accent hover:text-accent-dim transition-colors">AI Agent Plugin &rarr;</a>
        </div>
      </div>
    </section>

    <!-- Bottom CTA -->
    <section class="px-6 md:px-12 py-16 md:py-24 border-t border-border">
      <div class="max-w-2xl mx-auto text-center">
        <h2 class="text-text-primary text-2xl md:text-3xl font-bold tracking-tight mb-3">
          Try Laurel Proxy in 10 seconds
        </h2>
        <p class="text-text-secondary mb-6">
          Free, open source, MIT licensed. Works on macOS and Linux.
        </p>
        <div class="flex justify-center">
          <InstallBlock />
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>
