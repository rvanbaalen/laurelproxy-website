---
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import InstallBlock from "../../components/InstallBlock.astro";
import Footer from "../../components/Footer.astro";

const base = import.meta.env.BASE_URL;

const rows = [
  ["Price", "Free, open source (MIT)", "Free tier, plus paid Pro/Team tiers"],
  ["Platforms", "macOS, Linux (no Windows)", "macOS-focused"],
  ["Interface", "CLI, interactive TUI, Web UI, REST API", "Native desktop GUI"],
  ["HTTPS interception", "Yes — local root CA", "Yes — local root CA"],
  ["WebSocket capture", "No", "Yes"],
  ["HTTP/2 support", "No — MITM'd connections pinned to HTTP/1.1", "Yes"],
  ["Request breakpoints / live rewriting", "No", "Yes"],
  ["Bandwidth throttling", "No", "Yes"],
  ["Scripting / extensibility", "CLI filters and flags only", "Limited — GUI-first tool"],
  ["AI agent integration", "Claude Code plugin + skill, --format agent output", "None built-in"],
];

const faqs = [
  {
    q: "Is Laurel Proxy really free?",
    a: "Yes. Laurel Proxy is free and open source under the MIT license, with no paid tier. Proxyman offers a free tier plus paid Pro and Team tiers for its advanced features.",
  },
  {
    q: "Does Laurel Proxy have a native GUI like Proxyman?",
    a: "Laurel Proxy ships a browser-based Web UI with live traffic, filters, and a request repeater, but it's not a native macOS menu-bar app the way Proxyman is.",
  },
  {
    q: "Can Laurel Proxy fully replace Proxyman?",
    a: "Not for every workflow. Laurel Proxy is a strong fit if you want a free, terminal-first, AI-agent-friendly proxy on macOS or Linux. Proxyman still wins on WebSocket capture, breakpoints, throttling, and native macOS polish.",
  },
];
---

<Base
  title="Laurel Proxy vs Proxyman: A Free, Terminal-First Alternative"
  description="Compare Laurel Proxy and Proxyman: free and open source vs. freemium, CLI/Web UI vs. native macOS app, and where Proxyman still wins."
  structuredData={{
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  }}
>
  <Nav />

  <main id="main" role="main">
    <!-- Hero -->
    <section class="px-6 md:px-12 pt-16 md:pt-24 pb-12 md:pb-16">
      <div class="max-w-3xl mx-auto text-center">
        <span class="inline-block text-xs text-accent border border-accent/30 rounded-full px-3 py-1 mb-6 font-medium">
          Proxyman Alternative
        </span>

        <h1 class="text-text-primary text-3xl md:text-5xl font-extrabold tracking-tight leading-[1.1] mb-5">
          Laurel Proxy vs <span class="text-accent">Proxyman</span>
        </h1>

        <p class="text-text-secondary text-base md:text-xl leading-relaxed mb-8 max-w-2xl mx-auto">
          Proxyman is a polished, macOS-focused GUI with a free tier and paid upgrades. Laurel Proxy is a free,
          open-source, terminal-first proxy built for developers and AI agents. Here's an honest comparison.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <InstallBlock />
        </div>
      </div>
    </section>

    <!-- Comparison table -->
    <section class="px-6 md:px-12 py-12 md:py-16 border-t border-border">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-text-primary text-2xl md:text-3xl font-bold tracking-tight mb-6 text-center">
          Feature comparison
        </h2>
        <div class="overflow-x-auto rounded-lg border border-border">
          <table class="w-full text-sm border-collapse">
            <thead>
              <tr class="bg-bg-secondary">
                <th class="text-left text-text-primary font-semibold uppercase tracking-wide text-xs px-4 py-3 border-b border-border">Feature</th>
                <th class="text-left text-accent font-semibold uppercase tracking-wide text-xs px-4 py-3 border-b border-border">Laurel Proxy</th>
                <th class="text-left text-text-primary font-semibold uppercase tracking-wide text-xs px-4 py-3 border-b border-border">Proxyman</th>
              </tr>
            </thead>
            <tbody>
              {rows.map(([feature, laurel, proxyman], i) => (
                <tr class={i % 2 === 0 ? "" : "bg-bg-secondary/40"}>
                  <td class="px-4 py-3 border-b border-border text-text-primary font-medium align-top">{feature}</td>
                  <td class="px-4 py-3 border-b border-border text-text-secondary align-top">{laurel}</td>
                  <td class="px-4 py-3 border-b border-border text-text-secondary align-top">{proxyman}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Where Proxyman is better -->
    <section class="px-6 md:px-12 py-12 md:py-16 border-t border-border">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-text-primary text-2xl md:text-3xl font-bold tracking-tight mb-6">
          Where Proxyman is still better
        </h2>
        <p class="text-text-secondary mb-6 leading-relaxed">
          Proxyman is a mature, well-designed native app. Be honest with yourself about these gaps before you switch:
        </p>
        <ul class="space-y-3">
          <li class="flex items-start gap-3">
            <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-text-muted shrink-0"></span>
            <span class="text-text-secondary"><strong class="text-text-primary">WebSocket traffic.</strong> Laurel Proxy does not capture WebSocket connections at all. Proxyman does.</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-text-muted shrink-0"></span>
            <span class="text-text-secondary"><strong class="text-text-primary">Request breakpoints.</strong> Proxyman can pause a live request or response and let you edit it before it continues. Laurel Proxy only replays already-captured requests after the fact.</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-text-muted shrink-0"></span>
            <span class="text-text-secondary"><strong class="text-text-primary">Bandwidth throttling.</strong> Proxyman can simulate slow or constrained network conditions. Laurel Proxy has no throttling feature.</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-text-muted shrink-0"></span>
            <span class="text-text-secondary"><strong class="text-text-primary">Full HTTP/2 support.</strong> Laurel Proxy pins intercepted HTTPS connections to HTTP/1.1 via ALPN. Proxyman handles HTTP/2 natively.</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-text-muted shrink-0"></span>
            <span class="text-text-secondary"><strong class="text-text-primary">Native macOS polish.</strong> Proxyman is a purpose-built macOS menu-bar app. Laurel Proxy's Web UI runs in the browser, not as a native app.</span>
          </li>
        </ul>
      </div>
    </section>

    <!-- Choose / Stick with -->
    <section class="px-6 md:px-12 py-12 md:py-16 border-t border-border">
      <div class="max-w-4xl mx-auto grid md:grid-cols-2 gap-6">
        <div class="rounded-lg border border-accent/30 bg-bg-secondary/50 p-6">
          <h3 class="text-accent font-bold text-lg mb-4">Choose Laurel Proxy if...</h3>
          <ul class="space-y-2 text-text-secondary text-sm leading-relaxed">
            <li>You want a fully free tool with no paid tier to unlock features</li>
            <li>You're on Linux, where Proxyman isn't a fit</li>
            <li>You or your AI agent want to query traffic from a terminal or REST API</li>
            <li>You debug with Claude Code and want <code class="text-accent">--format agent</code> output</li>
          </ul>
        </div>
        <div class="rounded-lg border border-border bg-bg-secondary/50 p-6">
          <h3 class="text-text-primary font-bold text-lg mb-4">Stick with Proxyman if...</h3>
          <ul class="space-y-2 text-text-secondary text-sm leading-relaxed">
            <li>You want a native macOS app rather than a browser-based UI</li>
            <li>You need to inspect WebSocket traffic</li>
            <li>You need breakpoints to pause and edit live requests</li>
            <li>You need bandwidth throttling or simulated network conditions</li>
            <li>You need full HTTP/2 fidelity</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="px-6 md:px-12 py-12 md:py-16 border-t border-border">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-text-primary text-2xl md:text-3xl font-bold tracking-tight mb-6">
          Frequently asked questions
        </h2>
        <div class="space-y-6">
          {faqs.map((faq) => (
            <div>
              <h3 class="text-text-primary font-semibold mb-1">{faq.q}</h3>
              <p class="text-text-secondary text-sm leading-relaxed">{faq.a}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Docs links -->
    <section class="px-6 md:px-12 py-12 md:py-16 border-t border-border">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-text-primary text-xl md:text-2xl font-bold tracking-tight mb-4">
          Learn more
        </h2>
        <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm">
          <a href={`${base}docs/getting-started/`} class="text-accent hover:text-accent-dim transition-colors">Getting Started &rarr;</a>
          <a href={`${base}docs/web-ui/`} class="text-accent hover:text-accent-dim transition-colors">Web UI &rarr;</a>
          <a href={`${base}docs/https/`} class="text-accent hover:text-accent-dim transition-colors">HTTPS Interception &rarr;</a>
          <a href={`${base}docs/agent-plugin/`} class="text-accent hover:text-accent-dim transition-colors">AI Agent Plugin &rarr;</a>
        </div>
      </div>
    </section>

    <!-- Bottom CTA -->
    <section class="px-6 md:px-12 py-16 md:py-24 border-t border-border">
      <div class="max-w-2xl mx-auto text-center">
        <h2 class="text-text-primary text-2xl md:text-3xl font-bold tracking-tight mb-3">
          Try Laurel Proxy in 10 seconds
        </h2>
        <p class="text-text-secondary mb-6">
          Free, open source, MIT licensed. Works on macOS and Linux.
        </p>
        <div class="flex justify-center">
          <InstallBlock />
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>
